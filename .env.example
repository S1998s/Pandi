# SMTP configuration for real-time booking emails
# For Gmail, use an App Password (not your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=washfixchennai@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Wash Fix Service <washfixchennai@gmail.com>"

# Booking recipient
BOOKING_TO=washfixchennai@gmail.com

# Optional backup inbox (comma not needed, keep single email)
BACKUP_BOOKING_TO=

# Send confirmation mail to customer when they provide email
SEND_CUSTOMER_CONFIRMATION=true

# WhatsApp number for booking fallback (country code + number, no + sign)
NEXT_PUBLIC_WHATSAPP_NUMBER=919445959685

# Allowed origins for POST /api/book (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://washfixservice.in,https://www.washfixservice.in
